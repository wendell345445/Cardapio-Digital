# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menupanda"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/menupanda_test"

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
# OWNER/ADMIN access: 15m, refresh: 7d
# MOTOBOY access: 8h, refresh: 7d
# CLIENT magic link: 24h

# ─── OAUTH PROVIDERS ──────────────────────────────────────────────────────────
# v2.5+: nomenclatura padronizada `*_APP_ID/SECRET` + flag `*_APP_ENABLE`.
# Provider só é registrado em runtime se a flag estiver `'true'` E as credenciais não vazias.
# Callback URL é derivado dinamicamente do host do request (ver auth.routes.ts).
# Registre no Google Console e Facebook App: {host}/api/v1/auth/{provider}/callback.

# Google OAuth (v2.5+)
GOOGLE_APP_ID="your-google-client-id"
GOOGLE_APP_SECRET="your-google-client-secret"
GOOGLE_APP_ENABLE="false"

# Facebook OAuth (v2.5+)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_APP_ENABLE="false"

# ─── ASAAS (billing/assinaturas) ──────────────────────────────────────────────
# Sandbox: ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3 + chave $aact_hmlg_...
# Produção: ASAAS_BASE_URL=https://api.asaas.com/v3 + chave $aact_prod_...
# Webhook: apontar POST /api/v1/webhooks/asaas no painel Asaas com o ASAAS_WEBHOOK_TOKEN.
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY="$aact_hmlg_your-asaas-sandbox-key"
ASAAS_USER_AGENT="MenuPanda"
ASAAS_WEBHOOK_TOKEN="your-random-webhook-token"
# Grace period (dias) após falha/atraso de cobrança antes da suspensão automática da loja
# (enforced pelo cron trial-suspension.job). Default: 1 dia.
GRACE_PERIOD_DAYS=1
# Ciclo de cobrança recorrente (cartão + PIX Auto). Default MONTHLY. Em sandbox use
# WEEKLY pra validar a recorrência em 7 dias. Valores: WEEKLY|MONTHLY|QUARTERLY|...
BILLING_CYCLE="MONTHLY"
# Valor dos planos em BRL. Default produção 99/149. Em sandbox use valores baixos
# (ex: 1 e 3) pra testar sem cobrar caro. Vazio = usa o default de produção.
# PLAN_VALUE_PROFESSIONAL=99
# PLAN_VALUE_PREMIUM=149

# ─── CLOUDINARY ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── WHATSBOT (IA self-hosted GCP — Plano Premium) ────────────────────────────
# VM whatsbot.menupanda.ai (us-east1, Ollama + pgvector + RAG por cliente×loja).
# mTLS + X-API-Key. Certs gerados por infra/whatsbot/gen-mtls-certs.sh.
# Sem fallback: se a VM cair, o ai-handler loga e não envia nada ao cliente.
WHATSBOT_URL="https://whatsbot.menupanda.ai"
WHATSBOT_API_KEY=""
WHATSBOT_CLIENT_CERT_B64=""
WHATSBOT_CLIENT_KEY_B64=""

# ─── SMTP (E-MAIL TRANSACIONAL) ───────────────────────────────────────────────
# Templates HTML editáveis em: api/src/shared/email/templates/*.html
#
# DEV (MailHog/Mailpit local):
#   SMTP_HOST=localhost  SMTP_PORT=1025  (sem auth)
#
# PROD (Gmail SMTP — usar App Password, NÃO a senha da conta):
#   1. Habilite 2FA em myaccount.google.com → Security → 2-Step Verification
#   2. Gere App Password em myaccount.google.com → Security → App passwords
#   3. Use abaixo:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Menu Panda <your-email@gmail.com>"

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Domínio raiz do produto — usado pra gerar URLs públicas das lojas
# (`{slug}.${PUBLIC_ROOT_DOMAIN}`), tenant routing por subdomínio, fallback de CORS,
# e fallback dos emails (`noreply@`, `contato@`). Sempre que esta env muda, o sistema
# inteiro passa a usar o novo domínio sem precisar recompilar.
#
# Dev local com dnsmasq:    cardapio.test
# Produção:                  menupanda.ai
PUBLIC_ROOT_DOMAIN="menupanda.ai"

# Email de suporte exibido em templates (ex: trial-suspended). Default: contato@${PUBLIC_ROOT_DOMAIN}
SUPPORT_EMAIL="contato@menupanda.ai"

# ─── GEO STACK (OSM self-hosted: Photon + Nominatim + OSRM) ───────────────────
# Substitui Google Geocoding/Places/ViaCEP. Stack rodando em geo.menupanda.ai
# (VM GCP, Brazil-only). Cache Redis 7d por endereço/coordenada normalizada.
#
# - Photon (autocomplete typeahead, lang=default — NÃO aceita lang=pt)
# - Nominatim (geocoding texto → coord, reverse coord → endereço com CEP opcional)
# - OSRM (rota real de carro — substitui Haversine no cálculo de frete)
#
# Auth: mTLS (cert de cliente assinado pela CA privada) + header X-API-Key.
# Browser NUNCA chama o geo direto — sempre via api Railway (/menu/geo/* e
# /admin/delivery/geo/*).

# URLs públicas do reverse proxy (Caddy) — Photon/Nominatim/OSRM ficam atrás.
GEO_AUTOCOMPLETE_URL=https://geo.menupanda.ai/photon
GEO_GEOCODING_URL=https://geo.menupanda.ai/nominatim
GEO_ROUTING_URL=https://geo.menupanda.ai/osrm

# Chave compartilhada pro header X-API-Key (defense-in-depth por cima do mTLS).
# Mesmo valor que está em infra/geo/.env (GEO_API_KEY).
GEO_API_KEY="paste-from-infra-geo-dot-env"

# mTLS — duas formas, o cliente escolhe a primeira que existir:
#   DEV LOCAL: aponte pros arquivos (mais simples).
GEO_CLIENT_CERT_PATH="../infra/geo/certs/client.crt"
GEO_CLIENT_KEY_PATH="../infra/geo/certs/client.key"
#   PROD (Railway): cole o base64 dos arquivos (não suporta path em runtime).
#   Gerar:  base64 < infra/geo/certs/client.crt | tr -d '\n'
#           base64 < infra/geo/certs/client.key | tr -d '\n'
# GEO_CLIENT_CERT_B64=""
# GEO_CLIENT_KEY_B64=""

# ─── LOCAL NETWORK (dnsmasq) ─────────────────────────────────────────────────
# LAN IP da máquina dev (auto-detectado por infra/scripts/setup-dev.sh)
# Usado pelo dnsmasq para resolver *.cardapio.test na rede local
LAN_IP=192.168.0.X

# ─── iFood (integração — Premium) ─────────────────────────────────────────────
# App Centralizado. Teste: credenciais do app de teste (auto-criado na conta).
# Prod: app "Menu Panda" só libera credenciais após homologação (abrir ticket).
# O webhook é assinado com HMAC-SHA256 do body usando o CLIENT_SECRET (não há
# secret de webhook separado — o iFood usa o mesmo clientSecret dos tokens).
IFOOD_BASE_URL="https://merchant-api.ifood.com.br"
IFOOD_CLIENT_ID="your-ifood-client-id"
IFOOD_CLIENT_SECRET="your-ifood-client-secret"
